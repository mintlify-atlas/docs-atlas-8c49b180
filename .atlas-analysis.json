  "keyFeatures": [
    "MLX Rust bindings for Apple Silicon GPU acceleration",
    "Shared inference infrastructure (KV cache, RoPE, attention)",
    "Multiple LLM families (Qwen, GLM, Mixtral, Mistral, MiniCPM)",
    "Vision-language models with dual encoders",
    "Multi-language speech recognition (30+ languages)",
    "Few-shot voice cloning and TTS",
    "Fast image generation with FLUX and Z-Image",
    "OpenAI-compatible API server",
    "8-bit quantization support",
    "Zero Python runtime for inference"
  ],
